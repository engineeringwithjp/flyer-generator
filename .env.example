# ============================================================
#  Claude
# ============================================================
ANTHROPIC_API_KEY=
# Model used for planning, copywriting, design direction and QA
ANTHROPIC_MODEL=claude-opus-5
# Optional cheaper model for bulk reference-image vision tagging
ANTHROPIC_VISION_MODEL=claude-sonnet-5
ANTHROPIC_MAX_RETRIES=4

# ============================================================
#  Google Drive  (OAuth user credentials - recommended)
#  Generate a refresh token with: python scripts/google_oauth_setup.py
#  Leave blank to skip Drive upload entirely.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 'Client Flyers' folder, verified 2026-09-05
GOOGLE_DRIVE_ROOT_FOLDER_ID=12Ho15EiJumnZkSAPm0I1Zd9Vwe6CuLiT
# Optional alternative: path to a service-account JSON key
# (service accounts have no My Drive quota - only use with a Shared Drive)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_IS_SHARED_DRIVE=0

# ---- Google Drive for Desktop (simplest option, no OAuth) ----
# Write flyers straight into a mounted Drive folder so nothing accumulates
# locally. Detect and set it automatically with:  flyer drive-setup --write
DRIVE_LOCAL_PATH=

# ============================================================
#  Defaults
# ============================================================
DEFAULT_CLIENT=all-elite
DEFAULT_FLYER_COUNT=2

SCHEDULE_TIMEZONE=America/New_York

# daily    = one run at SCHEDULE_TIME
# interval = a run every SCHEDULE_INTERVAL_HOURS inside SCHEDULE_WINDOW
SCHEDULE_MODE=daily
SCHEDULE_TIME=10:07
SCHEDULE_INTERVAL_HOURS=3
SCHEDULE_WINDOW=08:00-20:00
# mon-fri | all | mon,wed,fri | sat,sun
SCHEDULE_DAYS=mon-fri

OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1350
OUTPUT_FORMAT=PNG

# ---- Disk hygiene ----
# Largest edge kept for stored photography. A 1080x1350 flyer never needs more.
ASSET_MAX_EDGE=2400
# `flyer clean` prunes rendered flyers older than this (uploaded ones only).
OUTPUT_RETENTION_DAYS=7
# Delete the local copy once a flyer is confirmed in Drive (API upload path).
DELETE_AFTER_UPLOAD=0

# Set to 1 to run the whole pipeline without calling Claude
# (deterministic fallback strategy + copy - used by tests and `make preview`)
FLYER_OFFLINE=0
LOG_LEVEL=INFO
