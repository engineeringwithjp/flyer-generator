# ==============================================================================
# FLYER GENERATOR ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Claude API Configuration (optional if running locally via Claude Code)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Drive Integration
# Target folder ID (from your Google Drive folder URL)
GDRIVE_ROOT_FOLDER_ID=12Ho15EiJumnZkSAPm0I1Zd9Vwe6CuLiT

# Provide either Service Account Key (recommended for automated/GitHub Actions)
# or path to service_account.json
# GDRIVE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
GDRIVE_SERVICE_ACCOUNT_PATH=service_account.json

# Optional Connected Design Ecosystem API Keys
# (The system operates seamlessly offline using internal fallback if omitted)
UNSPLASH_ACCESS_KEY=
CANVA_API_KEY=
FIGMA_ACCESS_TOKEN=
MOBBIN_API_KEY=

# Default Execution Parameters
DEFAULT_CLIENT=all-elite
DAILY_FLYER_COUNT=2
LOG_LEVEL=INFO
