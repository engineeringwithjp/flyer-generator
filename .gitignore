# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*credentials*.json
*service-account*.json
token.json

# Generated flyers (Google Drive is the archive)
output/**
!output/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Downloaded fonts (fetched by scripts/fetch_fonts.py)
assets/fonts/*.ttf
assets/fonts/*.otf

# OS
.DS_Store
Thumbs.db

# Raw client media awaiting review. Large, and Google Drive is the archive.
# Curated production assets live in clients/*/assets/approved/ and ARE tracked.
clients/*/assets/raw/**
!clients/*/assets/raw/.gitkeep

# Claude Code worktrees are scratch checkouts, never part of the repo.
.claude/worktrees/

# Setuptools build metadata
*.egg-info/

# Locally staged flyers withdrawn from Drive for review
output/withdrawn/
